% \subsection{Liquid rendering}
%    \begin{macrocode}


\cs_new_protected:Npn \__lqt_input_liquid:nn #1#2
  {
    % Check that the template file exists
    \IfFileExists{ #1 }
      {}
      {
        \msg_error:nnx
          { liquidtex } { missing-template }
          { #1 }
      }

    \tl_if_eq:VnTF \__lqt_engine_tl { external }
      { \__lqt_render:nn { #1 }{ #2 } }
      {
        \msg_error:nnx
          { liquidtex } { engine-not-external }
          { \tl_use:N \__lqt_engine_tl }
      }
  }

\NewDocumentCommand \inputliquid { O{} m }
  {
    % #1 = optional data override, #2 = template
    \tl_set:Nn \l__lqt_tmp_template_tl { #2 }
    \tl_set:Nx \l__lqt_tmp_data_tl
      {
        \tl_if_blank:nTF { #1 }
          { \__lqt_data_path_tl }
          { #1 }
      }
    \__lqt_input_liquid:nn
      { \tl_use:N \l__lqt_tmp_template_tl }
      { \tl_use:N \l__lqt_tmp_data_tl }
  }

\NewDocumentEnvironment { liquid } { O{} +b }
  {
    % #1 = optional data override / #2 = body (template contents)

    % Increment inline counter
    \int_gincr:N \c__lqt_inlines_cnt_int

    % Get template cache filename
    \__lqt_compute_inline_template_filename:

    % Store the data argument (may be blank, meaning "use global data")
    \tl_set:Nn \l__lqt_inline_data_tl { #1 }

    \__lqt_write_to_file:n { #2 }

    % Resolve which data file to use:
    \tl_set:Nx \l__lqt_tmp_data_tl
      {
        \tl_if_blank:VTF \l__lqt_inline_data_tl
          { \__lqt_data_path_tl } % fall back to global 'data' key
          { \l__lqt_inline_data_tl }
      }

    % Now just reuse your existing pipeline:
    \__lqt_input_liquid:nn
      { \tl_use:N \l__lqt_inline_template_tl }
      { \tl_use:N \l__lqt_tmp_data_tl }
  }
  {}


  
