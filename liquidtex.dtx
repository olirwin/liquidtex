%    \end{macrocode}
% On définit le chemin \enquote{lqt} par défaut des clés \enquote{pgf}.
%    \begin{macrocode}
\pgfkeys{/lqt/.is family}
\pgfkeys{/lqt/.cd}
\def\lqtsetup{\pgfqkeys{/lqt}}
%    \end{macrocode}
% On interdit l'utilisation de ×\lqtsetup× ailleurs qu'en préambule.
%    \begin{macrocode}
% \@onlypreamble\lqtsetup%
%    \end{macrocode}
%    \begin{macrocode}
\newcommand{\LQT@create@boolean}[1]{%
  % \yadsetup{#1/.is if = #1}
  \newbool{LQT@#1}%
  \lqtsetup{%
    #1/.is choice,
    #1/true/.code={%
      \booltrue{LQT@#1}%
    },
    #1/false/.code={%
      \boolfalse{LQT@#1}%
    },
    #1/.default=true,
  }%
  % }{%
  %   \ClassWarningNoLine{yathesis}{%
  %     Valeur passée à la clé `#1' non valide :\MessageBreak%
  %     cette valeur ne peut être que `true' ou `false'%
  %   }%
  % }%
}%
% \LQT@create@boolean{nolink}%
\LQT@create@boolean{noerror}%
%
\lqtsetup{noerror=true}%
%
%
%    \end{macrocode}
%
% On crée des \enquote{hooks} permettant de passer, en option de
% ×\documentclass×, des options aux packages chargés par la classe qui :
% \begin{enumerate}
