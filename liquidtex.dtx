% \subsection{Key definitions}
%
% We define a key family \texttt{liquidtex} with one boolean key.
%
%    \begin{macrocode}
\keys_define:nn { liquidtex }
  {
    verbose .bool_set:N = \__lqt_verbose_bool,
    verbose .initial:n  = false,
    verbose .default:n  = true,

    outdir  .tl_set:N   = \__lqt_outdir_tl,
    outdir  .initial:n  = {.liquid-cache},
    outdir  .usage:n    = preamble,

    use-auxdir .bool_set:N = \__lqt_use_auxdir_bool,
    use-auxdir .initial:n  = true,
    use-auxdir .default:n  = true,
    use-auxdir .usage:n    = preamble,

    no-cache .bool_set:N = \__lqt_no_cache_bool,
    no-cache .initial:n  = false,
    no-cache .default:n  = true,
    no-cache .usage:n    = preamble,

    engine .choice:,
    engine / lua .code:n      =
    { \tl_set:Nn \__lqt_engine_tl { lua } },
    engine / external .code:n =
    { \tl_set:Nn \__lqt_engine_tl { external } },
    engine / unknown .code:n =
    {
      \msg_error:nnx { liquidtex } { unknown-engine } {#1}
    },

    engine .initial:n = external,
    engine .usage:n   = preamble,

    engine-conf .code:n =
    { \keys_set:nn { liquidtex / engine-conf } { #1 } },
    engine-conf .usage:n = preamble,

    data .tl_set:N   = \__lqt_data_path_tl,
    data .initial:n  = {},
  }

\keys_define:nn { liquidtex / engine-conf }
{
  path .tl_set:N   = \__lqt_engine_path_tl,
  path .initial:n  = {},

  positional .code:n = { \tl_set:Nn \__lqt_engine_arg_style_tl { positional } },
  named      .code:n = { \tl_set:Nn \__lqt_engine_arg_style_tl { named } },

  arg-style .choice:,
  arg-style / positional .code:n =
  { \tl_set:Nn \__lqt_engine_arg_style_tl { positional } },
  arg-style / named .code:n =
  { \tl_set:Nn \__lqt_engine_arg_style_tl { named } },
  arg-style .initial:n = positional,

  template-index .int_set:N = \__lqt_engine_template_index_int,
  template-index .initial:n = 1,

  data-index .int_set:N = \__lqt_engine_data_index_int,
  data-index .initial:n = 2,

  output-index .int_set:N = \__lqt_engine_output_index_int,
  output-index .initial:n = 3,
}
