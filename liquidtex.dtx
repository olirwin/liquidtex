%    \begin{macrocode}
%      Check configuration existence when using external engine.
\cs_new_protected:Npn \__lqt_check_engine_config:
{
  % Only relevant if engine = external
  \tl_if_eq:VnT \__lqt_engine_tl { external }
  {
    % Require a non-empty path
    \tl_if_blank:VTF \__lqt_engine_path_tl
    {
      \msg_error:nn { liquidtex } { external-engine-config-missing }
    }
    { % later we can add more checks here (indices, arg-style, etc.)
    }
  }
}

