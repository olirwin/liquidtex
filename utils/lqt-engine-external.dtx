%<*package>
\ProvidesExplPackage{lqt-engine-external}{2026-11-05}{0.3.0}{Liquid engine bridge}
\ExplSyntaxOn
\cs_new_protected:Npn \__lqt_locate_runtime:
  {
    \tl_set:Nx \l__lqt_runtime_tl {\file_full_name:n {scripts/lqt_runtime.lua}}
    \tl_if_empty:NT \l__lqt_runtime_tl
      {\tl_set:Nx \l__lqt_runtime_tl {\file_full_name:n {lqt_runtime.lua}}}
    \tl_set:Nx \l__lqt_bridge_tl {\file_full_name:n {scripts/lqt_bridge.lua}}
    \tl_if_empty:NT \l__lqt_bridge_tl
      {\tl_set:Nx \l__lqt_bridge_tl {\file_full_name:n {lqt_bridge.lua}}}
    \tl_if_empty:NT \l__lqt_runtime_tl
      {\msg_fatal:nnn {liquidtex}{runtime-failed}{Missing~lqt_runtime.lua.~Reinstall~the~complete~package.}}
  }
\cs_new_protected:Npn \__lqt_shell_quote:n #1
  {
    \tl_set:Nx \l__lqt_quote_tl {\tl_to_str:e {#1}}
    \sys_if_platform_windows:TF
      {
        \exp_args:NnV \regex_match:nnT {[\x{22}\x{25}!&|<>\x{5e}]} \l__lqt_quote_tl
          {\msg_fatal:nnn {liquidtex}{runtime-failed}{Unsupported~Windows~shell~metacharacter.}}
        \tl_set:Nx \l__lqt_quote_tl {"\exp_not:V \l__lqt_quote_tl"}
      }
      {
        \tl_replace_all:Nnn \l__lqt_quote_tl {'}{'"'"'}
        \tl_set:Nx \l__lqt_quote_tl {'\exp_not:V \l__lqt_quote_tl'}
      }
  }
\cs_new_protected:Npn \__lqt_invoke:
  {
    \bool_set_false:N \__lqt_success_bool
    \str_if_eq:VnTF \__lqt_engine_tl {lua}
      {
        \__lqt_native_init:
        \directlua{liquidtex_runtime.run_file("\luaescapestring{\l__lqt_request_tl}")}
      }
      {
        \sys_if_shell_unrestricted:TF
          {
            \__lqt_locate_runtime:
            \__lqt_shell_quote:n {\l__lqt_bridge_tl}
            \exp_args:Ne \sys_get_shell:nnN {kpsewhich~--format=tex~\l__lqt_quote_tl}{} \l__lqt_bridge_tl
            \tl_trim_spaces:N \l__lqt_bridge_tl
            \__lqt_shell_quote:n {\l__lqt_bridge_tl}
            \tl_set:Nx \l__lqt_command_tl {texlua~\exp_not:V \l__lqt_quote_tl}
            \__lqt_shell_quote:n {\l__lqt_request_tl}
            \tl_put_right:Nx \l__lqt_command_tl {~\exp_not:V \l__lqt_quote_tl}
            \__lqt_log:nn {trace}{\l__lqt_command_tl}
            \sys_shell_now:x {\l__lqt_command_tl}
          }
          {\msg_fatal:nn {liquidtex}{shell-escape-required}}
      }
    \file_input:V \l__lqt_result_tl
    \str_if_eq:VnT \__lqt_log_level_tl {trace}{\__lqt_log_file:n {\l__lqt_log_tl}}
  }
\ExplSyntaxOff
%</package>
%\Finale
\endinput
