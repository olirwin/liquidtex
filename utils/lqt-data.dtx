%<*package>
\def\lqtdataversion{0.1.0}
\def\lqtdatadate{2025-11-20}
\NeedsTeXFormat{LaTeX2e}[2020-01-01]
\ProvidesExplPackage
  {lqt-data}
  {\lqtdatadate}
  {\lqtdataversion}
  {Data handling for the `liquidtex` package}

\RequirePackage{expl3}
\RequirePackage{lqt-messages}
\ExplSyntaxOn

% #1 = user-specified data ref (namespace or literal path, may be blank)
% #2 = storage for resolved filename
\cs_new_protected:Npn \__lqt_resolve_data_source:nN #1#2 { %
  \bool_if:NT \__lqt_verbose_bool { %
    \msg_info:nnxx { liquidtex } { resolve-data-source } %
    { #1 }{} %
  }

  \tl_if_blank:nTF { #1 } {
    % Blank => use 'default'
    \prop_get:NnNTF \g__lqt_data_sources_prop { default } #2 {} { %
      % no 'default' registered: error
      \msg_fatal:nn { liquidtex } { default-data-missing }
    }
  } { %
    % Non-blank => try as named data source
    \prop_get:NnNTF \g__lqt_data_sources_prop { #1 } #2 {} { %
      % not found: treat #1 as literal filename
      \tl_set:Nn #2 { #1 } %
    } %
  } %

  \bool_if:NT \__lqt_verbose_bool { %
    \msg_info:nnxx { liquidtex } { resolve-data-source } %
    { #1 }{ #2 } %
  }

}

\ExplSyntaxOff
%</package>
%\Finale
\endinput
