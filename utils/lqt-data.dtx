%<*package>
\ProvidesExplPackage{lqt-data}{2026-11-05}{0.3.0}{Liquid data resolution}
\ExplSyntaxOn
\cs_new_protected:Npn \__lqt_alias_missing:n #1
  {\msg_error:nnn {liquidtex}{unknown-option}{data-sources/#1}}
\cs_new_protected:Npn \__lqt_alias_set:nn #1#2
  {\prop_gput:Nnn \g__lqt_data_sources_prop {#1}{#2}}
\cs_new_protected:Npn \__lqt_resolve_data:n #1
  {
    \tl_set:Nx \l_tmpa_tl {#1}
    \tl_if_blank:VTF \l_tmpa_tl
      {\prop_get:NnN \g__lqt_data_sources_prop {default} \l__lqt_data_tl}
      {
        \prop_get:NVNTF \g__lqt_data_sources_prop \l_tmpa_tl \l__lqt_data_tl
          {}{\tl_set_eq:NN \l__lqt_data_tl \l_tmpa_tl}
      }
    \tl_if_blank:VF \l__lqt_data_tl
      {
        \file_if_exist:VTF \l__lqt_data_tl
          {\tl_set:Nx \l__lqt_data_tl {\file_full_name:V \l__lqt_data_tl}}
          {\msg_fatal:nnx {liquidtex}{runtime-failed}{Missing~data~file~\l__lqt_data_tl}}
      }
  }
\ExplSyntaxOff
%</package>
%\Finale
\endinput
