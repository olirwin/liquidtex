%<*package>
\ProvidesExplPackage{lqt-files}{2026-11-05}{0.3.0}{Liquid request files}
\ExplSyntaxOn
\cs_new_protected:Npn \__lqt_resolve_template:n #1
  {
    \tl_set:Nx \l__lqt_template_tl {#1}
    \file_if_exist:VF \l__lqt_template_tl
      {
        \tl_set_eq:NN \l_tmpa_tl \l__lqt_template_tl
        \clist_map_inline:Nn \__lqt_template_paths_clist
          {
            \file_if_exist:nT {##1/\l_tmpa_tl}
              {\tl_set:Nx \l__lqt_template_tl {##1/\l_tmpa_tl} \clist_map_break:}
          }
      }
    \file_if_exist:VTF \l__lqt_template_tl
      {\tl_set:Nx \l__lqt_template_tl {\file_full_name:V \l__lqt_template_tl}}
      {\msg_fatal:nnx {liquidtex}{missing-template}{\l__lqt_template_tl}}
  }
\cs_generate_variant:Nn \tl_replace_all:Nnn {Nee}
\cs_new_protected:Npn \__lqt_json:n #1
  {
    \tl_set:Nx \l__lqt_json_tl {\tl_to_str:e {#1}}
    \tl_replace_all:Nee \l__lqt_json_tl {\c_backslash_str}{\c_backslash_str\c_backslash_str}
    \tl_replace_all:Nee \l__lqt_json_tl {"}{\c_backslash_str"}
    \tl_replace_all:Nee \l__lqt_json_tl {\char_generate:nn {10}{12}}{\c_backslash_str n}
    \tl_replace_all:Nee \l__lqt_json_tl {\char_generate:nn {13}{12}}{\c_backslash_str r}
    \tl_replace_all:Nee \l__lqt_json_tl {\char_generate:nn {9}{12}}{\c_backslash_str t}
  }
\cs_new_protected:Npn \__lqt_field:nn #1#2
  {
    \__lqt_json:n {#2}
    \iow_now:Nx \l__lqt_request_iow {"#1":"\exp_not:V \l__lqt_json_tl",}
  }
\cs_new_protected:Npn \__lqt_array:N #1
  {
    \tl_clear:N \l__lqt_collection_tl
    \clist_map_inline:Nn #1
      {
        \tl_if_empty:NF \l__lqt_collection_tl {\tl_put_right:Nn \l__lqt_collection_tl {,}}
        \__lqt_json:n {##1}
        \tl_put_right:Nx \l__lqt_collection_tl {"\exp_not:V \l__lqt_json_tl"}
      }
  }
\cs_new_protected:Npn \__lqt_write_request:
  {
    \tl_set:Nx \l__lqt_request_tl {\c_sys_jobname_str .lqt-request.json}
    \iow_open:NV \l__lqt_request_iow \l__lqt_request_tl
    \iow_now:Nx \l__lqt_request_iow {\c_left_brace_str}
    \__lqt_field:nn {document}{\c_sys_jobname_str}
    \__lqt_field:nn {template_path}{\l__lqt_template_tl}
    \__lqt_field:nn {data_path}{\l__lqt_data_tl}
    \__lqt_field:nn {action}{\l__lqt_action_tl}
    \__lqt_field:nn {array_key}{\l__lqt_array_key_tl}
    \__lqt_field:nn {section_toc}{\l__lqt_section_toc_tl}
    \__lqt_field:nn {outdir}{\__lqt_outdir_tl}
    \__lqt_field:nn {debug_dir}{\__lqt_debug_dir_tl}
    \iow_now:Nx \l__lqt_request_iow
      {"no_cache":\bool_if:NTF \__lqt_no_cache_bool {true}{false},
       "use_auxdir":\bool_if:NTF \__lqt_use_auxdir_bool {true}{false},}
    \__lqt_array:N \__lqt_data_files_clist
    \iow_now:Nx \l__lqt_request_iow {"data_files":[\exp_not:V \l__lqt_collection_tl],}
    \tl_clear:N \l__lqt_collection_tl
    \prop_map_inline:Nn \g__lqt_namespaces_prop
      {
        \tl_if_empty:NF \l__lqt_collection_tl {\tl_put_right:Nn \l__lqt_collection_tl {,}}
        \__lqt_json:n {##1}
        \tl_put_right:Nx \l__lqt_collection_tl {"\exp_not:V \l__lqt_json_tl":}
        \__lqt_json:n {##2}
        \tl_put_right:Nx \l__lqt_collection_tl {"\exp_not:V \l__lqt_json_tl"}
      }
    \iow_now:Nx \l__lqt_request_iow
      {"namespaces":\c_left_brace_str\exp_not:V \l__lqt_collection_tl\c_right_brace_str,}
    \str_if_eq:VnT \__lqt_engine_tl {external}
      {
        \iow_now:Nx \l__lqt_request_iow {"external":\c_left_brace_str}
        \__lqt_field:nn {path}{\__lqt_engine_path_tl}
        \__lqt_field:nn {arg_style}{\__lqt_arg_style_tl}
        \__lqt_array:N \__lqt_arguments_clist
        \iow_now:Nx \l__lqt_request_iow
          {"arguments":[\exp_not:V \l__lqt_collection_tl],
           "template_index":\int_use:N \__lqt_template_index_int,
           "data_index":\int_use:N \__lqt_data_index_int,
           "output_index":\int_use:N \__lqt_output_index_int\c_right_brace_str,}
      }
    \iow_now:Nx \l__lqt_request_iow {"version":1\c_right_brace_str}
    \iow_close:N \l__lqt_request_iow
    \tl_set:Nx \l__lqt_request_tl {\file_full_name:V \l__lqt_request_tl}
    \tl_set_eq:NN \l__lqt_result_tl \l__lqt_request_tl
    \regex_replace_once:nnN {\.json\Z}{.result.tex} \l__lqt_result_tl
    \tl_set_eq:NN \l__lqt_output_tl \l__lqt_request_tl
    \regex_replace_once:nnN {\.json\Z}{.output.tex} \l__lqt_output_tl
    \tl_set_eq:NN \l__lqt_log_tl \l__lqt_request_tl
    \regex_replace_once:nnN {\.json\Z}{.log} \l__lqt_log_tl
    \iow_open:NV \l__lqt_request_iow \l__lqt_result_tl
    \iow_now:Nn \l__lqt_request_iow {\liquidtexfailure{}}
    \iow_close:N \l__lqt_request_iow
  }
\cs_new_protected:Npn \__lqt_record_file:n #1
  {
    \ior_open:Nn \l__lqt_ior {#1}
    \ior_close:N \l__lqt_ior
  }
\cs_new_protected:Npn \__lqt_log_file:n #1
  {
    \file_if_exist:nT {#1}
      {
        \ior_open:Nn \l__lqt_ior {#1}
        \ior_str_map_inline:Nn \l__lqt_ior {\iow_term:n {liquidtex:~##1}}
        \ior_close:N \l__lqt_ior
      }
  }
\ExplSyntaxOff
%</package>
